LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.cn
MINIMAX_LLM_BASE_URL=https://api.minimax.cn/anthropic
MINIMAX_LLM_MODEL=MiniMax-M3
MINIMAX_TTS_MODEL=speech-2.8-turbo
MINIMAX_VOICE_ID=socialmedia_female_2_v1
# Explicit opt-in after the PWA search reservation endpoint is deployed.
# The mounted PWA database permits 20 lifetime trial searches across all accounts;
# the Agent additionally permits at most 3 per call. Failed provider attempts count.
DUNNI_WEB_SEARCH_ENABLED=0
# Store the real value in Railway's private variables, never in this file.
DASHSCOPE_API_KEY=
# Agent and PWA must share the existing usage signing key. A missing key keeps
# search unavailable. Do not place the real value in this file.
POC_USAGE_HMAC_KEY=
POC_USAGE_ENDPOINT=https://your-pwa.example/api/yuling/usage/ingest
