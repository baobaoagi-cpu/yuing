# ══════════════════════════════════════════════════════════════
#  Voice Companion Kit — 環境變數範本
#  複製成 .env 後填入你自己的金鑰。.env 已被 .gitignore 忽略，不會進版控。
#  ⚠️ 絕對不要把填好的 .env 提交到 git。
# ══════════════════════════════════════════════════════════════

# ── LiveKit（模組 A 即時通話的傳輸層）──
# 到 https://cloud.livekit.io 開一個 project 取得
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── STT 語音辨識 ──
DEEPGRAM_API_KEY=
SONIOX_API_KEY=

# ── LLM 對話 / 會議摘要腦 ──
# provider: anthropic | minimax_m3
YULING_REALTIME_LLM_PROVIDER=anthropic
YULING_REALTIME_LLM_MODEL=claude-haiku-4-5
ANTHROPIC_API_KEY=
MINIMAX_M3_API_KEY=

# ── TTS 語音合成（MiniMax）──
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
# 你的克隆聲紋 ID（在 MiniMax 後台建立）
MINIMAX_DEFAULT_VOICE_ID=

# ── 其他 LLM（可選）──
GEMINI_API_KEY=
GOOGLE_API_KEY=

# ── 角色 ──
CHARACTER_NAME=AI

# ── 存取控制（防陌生人燒錢；留空=不檢查，僅本地測試用）──
YULING_ACCESS_SECRET=
